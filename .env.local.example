# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY

# Never put the secret key (sb_secret_... / service_role) in this file or in
# any NEXT_PUBLIC_ variable — it bypasses Row Level Security and must never
# reach the browser.
